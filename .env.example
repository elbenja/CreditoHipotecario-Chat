# Moonshot / Kimi — apps/api only. Never expose to the browser.
MOONSHOT_API_KEY=sk-replace-me
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
MOONSHOT_MODEL=kimi-k2.7-code-highspeed
API_PORT=8787

# apps/api, production only. Origin allowed to call the API (the deployed web app).
WEB_ORIGIN=https://your-app.vercel.app

# apps/web, production only. Origin of the deployed API. Public — not a secret.
# Left empty in dev so Vite's /api proxy handles it.
VITE_API_URL=https://your-api.onrender.com
