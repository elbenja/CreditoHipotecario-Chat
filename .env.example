# Moonshot / Kimi — apps/api only. Never expose to the browser.
MOONSHOT_API_KEY=sk-replace-me
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
MOONSHOT_MODEL=kimi-k2.7-code-highspeed
API_PORT=8787
# Public demo (no password), capped because every turn spends the key.
# Counters live in memory: they reset on restart and assume one instance.
# DEMO_TURNS=0 turns the demo off.
DEMO_TURNS=12
DEMO_DAILY_TURNS=150
DEMO_SESSIONS_PER_IP=3
